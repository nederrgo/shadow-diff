import px

# ponytail: two exports — PxL has no reliable OR. Client branch covers outside HTTP
# (trace_role=1 on worker); server branch covers in-cluster (trace_role=2 on
# downstream, scoped by remote client == worker). Shop Put keeps first 2xx.

# --- client / external ---
df = px.DataFrame(table='http_events', start_time='-60s', end_time=px.now())
df.namespace = df.ctx['namespace']
df.pod = df.ctx['pod']
df.service = df.ctx['service']
df = df[df.namespace == '__TARGET_NAMESPACE__']
df = df[df.trace_role == 1]
df.req_host = px.pluck(df.req_headers, 'Host')
df.traceparent = px.pluck(df.req_headers, 'traceparent')
__LABEL_FILTERS__
__EXCLUDE_PATH_FILTERS__
__SAMPLE_FILTERS__
df.end_time = df.time_ + df.latency
px.export(df, px.otel.Data(
  endpoint=px.otel.Endpoint(
    url='__RECORDER_OTEL_ENDPOINT__',
    insecure=True,
  ),
  resource={
    'service.name': df.service,
    'k8s.pod.name': df.pod,
    'k8s.namespace.name': df.namespace,
  },
  data=[
    px.otel.trace.Span(
      name=df.req_path,
      start_time=df.time_,
      end_time=df.end_time,
      attributes={
        'http.request.method': df.req_method,
        'url.path': df.req_path,
        'http.host': df.req_host,
        'http.request.body': df.req_body,
        'http.response.status_code': df.resp_status,
        'http.response.body': df.resp_body,
        'traceparent': df.traceparent,
      },
    ),
  ],
))

# --- server / in-cluster ---
df = px.DataFrame(table='http_events', start_time='-60s', end_time=px.now())
df.namespace = df.ctx['namespace']
df.pod = df.ctx['pod']
df.service = df.ctx['service']
df = df[df.namespace == '__TARGET_NAMESPACE__']
df = df[df.trace_role == 2]
df.req_host = px.pluck(df.req_headers, 'Host')
df.client_pod = px.pod_id_to_pod_name(px.ip_to_pod_id(df.remote_addr))
df.traceparent = px.pluck(df.req_headers, 'traceparent')
__REMOTE_CLIENT_FILTERS__
__EXCLUDE_PATH_FILTERS__
__SAMPLE_FILTERS__
df.end_time = df.time_ + df.latency
px.export(df, px.otel.Data(
  endpoint=px.otel.Endpoint(
    url='__RECORDER_OTEL_ENDPOINT__',
    insecure=True,
  ),
  resource={
    'service.name': df.service,
    'k8s.pod.name': df.pod,
    'k8s.namespace.name': df.namespace,
  },
  data=[
    px.otel.trace.Span(
      name=df.req_path,
      start_time=df.time_,
      end_time=df.end_time,
      attributes={
        'http.request.method': df.req_method,
        'url.path': df.req_path,
        'http.host': df.req_host,
        'http.request.body': df.req_body,
        'http.response.status_code': df.resp_status,
        'http.response.body': df.resp_body,
        'traceparent': df.traceparent,
      },
    ),
  ],
))
