# Standalone stress suite defaults. Override by exporting vars before run, or
# copy this file and: source /path/to/my.env && ./run_stress_test.sh

STRESS_N=1000
STRESS_RPS_START=500
STRESS_RPS_END=2000
STRESS_RAMP_SEC=60
STRESS_RUN_ID=                          # empty → auto UUID
STRESS_REQUEST_TIMEOUT_SEC=30

SHADOWTEST=bats-stress
SHADOWTEST_NS=default
PROD_TARGET_URL=http://http-rmq-python-prod.default.svc.cluster.local:8080/publish
# Set to 1 when PROD_TARGET_URL is cluster-internal (run load_gen via kubectl).
STRESS_LOAD_IN_CLUSTER=1

# Per-request egress expectations (replay / Postgres).
EXPECTED_EGRESS_HTTP=1
EXPECTED_EGRESS_AMQP=1
EXPECTED_EGRESS_DB=1
# Only HTTP egress is flushed to S3 during record (Kaisel → Shop).
EXPECTED_S3_EGRESS_PER_REQ=1

MINIO_BUCKET=shadow-diff-local
MINIO_ENDPOINT=http://minio-service.monarch-system.svc.cluster.local:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password
# Host-side MinIO when using port-forward (check_s3_counts.py from laptop).
MINIO_ENDPOINT_HOST=http://127.0.0.1:9000

POSTGRES_HOST=postgres.monarch-system.svc.cluster.local
POSTGRES_PORT=5432
POSTGRES_USER=beru
POSTGRES_PASSWORD=beru
POSTGRES_DB=beru
# Host-side Postgres when using port-forward.
POSTGRES_HOST_HOST=127.0.0.1
POSTGRES_PORT_HOST=15432

KAISEL_NS=kaisel-system

S3_FLUSH_WAIT_SEC=120
REPLAY_WAIT_SEC=600
POSTGRES_STABLE_POLLS=6
POSTGRES_STABLE_INTERVAL_SEC=10

STRESS_SKIP_APPLY=0
STRESS_SKIP_LOAD=0
# Delete and recreate ShadowTest before each run so session S3 prefix is clean.
STRESS_FRESH_SESSION=1
STRESS_DELETE_WAIT_SEC=180
